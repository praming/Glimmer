# ==========================================================
# 浮光 / Glimmer —— 环境变量样例
# 复制为 .env 后修改。生产环境请务必更换所有密钥。
# ==========================================================

# ---------- 运行环境 ----------
NODE_ENV=production
# API 监听端口（容器内）
PORT=3000
# 跨域允许来源（开发时 Nuxt 在 3001）
CORS_ORIGIN=http://localhost:3001

# ---------- 数据库与本地存储 ----------
# SQLite 数据库文件路径（容器内建议 /data/glimmer/glimmer.db）
DATABASE_URL=/data/glimmer/glimmer.db
# 本地存储后端根目录
LOCAL_STORAGE_DIR=/data/glimmer/uploads
# 临时目录（上传落盘缓冲，异步处理完成后清理）
TEMP_DIR=/data/glimmer/tmp

# ---------- 密钥（必改） ----------
# Session 签名/派生密钥，长度建议 >= 32 字符
SESSION_SECRET=please-change-me-to-a-long-random-string
# 敏感配置加密主密钥（AES-256-GCM），长度建议 >= 32 字符
ENCRYPTION_KEY=please-change-me-to-another-long-random-string

# ---------- Session ----------
# 会话有效期（天）。这是「未在个人资料里单独设置过」的账号的默认值；
# 用户可在「个人资料 → 会话有效期」自行改为 7/15/30/60/90 天，仅对本人生效。
SESSION_TTL_DAYS=7
SESSION_COOKIE_NAME=glimmer_session
# 仅 HTTPS 下设为 true。
# ⚠️ 用 http://<IP>:<端口> 访问时必须为 false —— 否则浏览器会丢弃登录 Cookie，
#    表现为「密码明明正确，却一直登录不上、刷新又变回未登录」。
# 配好 HTTPS 之后请改回 true（这样 Cookie 不会在明文连接里被带上）。
COOKIE_SECURE=false

# ---------- 初始管理员（首次启动时创建） ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ---------- 反向代理 ----------
# 是否信任反代传来的 X-Forwarded-For / X-Real-IP（登录限流据此取真实客户端 IP）。
# Nginx 反代部署保持 true（API 只在容器内网可达，请求头由 Nginx 覆写，无法伪造）；
# ⚠️ 若把 API 端口直接暴露到公网，必须改为 false，否则伪造该头即可绕过 IP 限流。
TRUST_PROXY=true

# ---------- 登录 / 改密限流 ----------
# 只统计「失败次数」，正常成功登录不会被计入，因此不必为正常使用预留额度。
# 单个来源 IP 在窗口内的失败上限（防止单机喷洒多个账号）
AUTH_RATE_LIMIT_MAX_PER_IP=20
# 单个账号在窗口内的失败上限（不含 IP，是真正挡住「磨同一个账号」的那一层）
AUTH_RATE_LIMIT_MAX_PER_ACCOUNT=5
# 窗口长度（秒），默认 15 分钟
AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# ---------- 默认对外访问地址 ----------
# 上传成功后写入「直链」的前缀，必须是**别人也能打开**的地址：
#   · 用 IP + 端口访问：  http://192.168.1.10:3001
#   · 已绑域名：          https://img.example.com
# 保持 localhost 的话，复制给别人的直链只有你这台机器能打开。
PUBLIC_BASE_URL=http://localhost:3001

# ---------- 上传限制 ----------
MAX_UPLOAD_SIZE_MB=20

# ---------- 异步队列 ----------
QUEUE_CONCURRENCY=2

# ---------- 前端（Nuxt） ----------
NUXT_PUBLIC_API_BASE=/api

# ---------- Docker 端口（供 compose 做变量替换，应用本身不读） ----------
# glimmer-web 的对外端口 —— 部署完成后你访问 http://<服务器IP>:<这个值>
# 想让地址里不带端口（直接 http://<IP>）就改成 80。
WEB_PORT=3001
# 仅「带 Nginx 启动」时生效：docker compose --profile nginx up -d
HTTP_PORT=80
HTTPS_PORT=443
# 仅「面板部署」时生效：docker compose -f docker-compose.1panel.yml
# 这两个是容器绑在回环地址上的端口，供宿主机上的 1Panel / 宝塔反代访问
API_HOST_PORT=3000
WEB_HOST_PORT=3001

# ---------- Docker 镜像来源 ----------
# 这两项是给 docker compose 做变量替换用的（会被 docker-compose.yml 读取），
# 不是应用自身的配置 —— 应用不会用到它们。
#
# 默认走「拉取官方镜像」，最快（镜像由 GitHub Actions 自动发布）：
#   docker compose pull && docker compose up -d --no-build
#
# 想从本地源码构建（镜像拉不到、或改过代码），把 --pull 换成 --build 即可，
# 此时这两项只是本地 tag，前缀留不留都无所谓：
#   docker compose up -d --build
#
# 若要固定版本，把 IMAGE_TAG 改成具体版本号（如 1.0.0）而不是 latest。
IMAGE_PREFIX=praming/
IMAGE_TAG=latest
