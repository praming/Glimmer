# ---------- 依赖与构建产物（容器内会重新安装 / 构建） ----------
**/node_modules
**/dist
**/.output
**/.nuxt
**/.data
**/*.tsbuildinfo

# ---------- 运行时数据（绝不进镜像） ----------
glimmer-data
data
uploads
*.db
*.db-journal
*.db-wal
*.db-shm

# ---------- 本地配置与密钥 ----------
.env
.env.*
!.env.example

# ---------- 证书 / 版本控制 / 本地工具 ----------
certs
.git
.github
.gitignore
.gitattributes
.workbuddy
.logs
*.log

# ---------- 构建期临时文件 ----------
tsup.config.bundled_*.mjs
